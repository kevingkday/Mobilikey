{
  "name": "mobilikey",
  "version": "1.0.0",
  "private": true,
  "description": "Mobilikey — Professional networking, factual business announcements, and three-level messaging access system.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mobilikey-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mobilikey-db --remote",
    "db:seed:local": "wrangler d1 execute mobilikey-db --local --file=./drizzle/seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "unpdf": "^2.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.7",
    "wrangler": "^3.112.0"
  }
}
